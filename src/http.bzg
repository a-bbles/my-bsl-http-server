// Include the BSL socket library
include("lib/socket.bzg");

// 1. Initialize Socket
if (socket_init() < 0) {
    print("Socket Initialization Failed\n");
} else {
    print("Socket Ready\n");
}

// 2. Create Socket Server
var server = socket_create();

if (server < 0) {
    print("Socket Creation Failed\n");
}

// 3. Bind Server to Port 8080
if (socket_bind(server, 0, 8080) < 0) {
    print("Socket Bind Failed.\n");
}

// 4. Listen for incoming connections
if (socket_listen(server, 5) < 0) {
    print("socket_listen() Failed.\n");
}

print("Server running on http://localhost:8080/\n");

while (1) {

    // 5. Accept Client Connection
    var client = socket_accept(server);

    print("Client connected!\n");

    // Read HTTP request
    var data = socket_read(client, 1024);

    if (sizeof(data) >= 0) {

        print("Received Request:\n" + data);

        var BODY = "";
        var HTTP = "";

        // Route: /
        if (data.indexOf("GET / ") >= 0 || data.indexOf("GET /HTTP") >= 0) {

            BODY = "<!DOCTYPE html><html><head>"
            + "<title>BSL Server - Home</title>"
            + "</head>"
            + "<body style='font-family:sans-serif;'>"
            + "<h1 style='color:#0f766e;'>Welcome to BSL HTTP Server</h1>"
            + "<p>This is the default landing page served on route '/'.</p>"
            + "<p>Built using the Bonezegei Scripting Language and Socket Library.</p>"
            + "</body></html>";

            HTTP = "HTTP/1.1 200 OK\r\n"
            + "Content-Type: text/html\r\n"
            + "Content-Length: " + sizeof(BODY) + "\r\n"
            + "Connection: close\r\n\r\n";

        // Route: /about
        } else if (data.indexOf("GET /about") >= 0) {

            BODY = "<!DOCTYPE html><html><head>"
            + "<title>BSL Server - About</title>"
            + "</head>"
            + "<body style='font-family:sans-serif;'>"
            + "<h1 style='color:#0f766e;'>About BSL HTTP Server</h1>"
            + "<p>This project is a low-level HTTP Web Server built using the Bonezegei Scripting Language.</p>"
            + "<p>The server uses the BSL Socket Library to accept client connections and respond to HTTP requests.</p>"
            + "<p>It runs locally on port 8080.</p>"
            + "</body></html>";

            HTTP = "HTTP/1.1 200 OK\r\n"
            + "Content-Type: text/html\r\n"
            + "Content-Length: " + sizeof(BODY) + "\r\n"
            + "Connection: close\r\n\r\n";

        // Route: anything else
        } else {

            BODY = "<!DOCTYPE html><html><head>"
            + "<title>404 Not Found</title>"
            + "</head>"
            + "<body style='font-family:sans-serif;'>"
            + "<h1 style='color:#e11d48;'>404 - Page Not Found</h1>"
            + "<p>The requested route does not exist on this BSL Server.</p>"
            + "<p>Please check the URL and try again.</p>"
            + "</body></html>";

            HTTP = "HTTP/1.1 404 Not Found\r\n"
            + "Content-Type: text/html\r\n"
            + "Content-Length: " + sizeof(BODY) + "\r\n"
            + "Connection: close\r\n\r\n";
        }

        // Send HTTP response
        socket_write(client, HTTP + BODY, sizeof(HTTP + BODY));

        // Close client connection
        socket_close(client);

        // Manual Garbage Collection
        gc();
    }
}

// Cleanup socket
socket_cleanup();
```

